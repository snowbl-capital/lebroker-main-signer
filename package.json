{
  "name": "lebroker-main-signer",
  "private": true,
  "type": "module",
  "description": "Signs a lebroker Main account's signature requests on its user's own machine, only those lebroker's allowlist accepts.",
  "scripts": {
    "main-signer": "bun src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0 && bun run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run lint && bun run typecheck && bun run test",
    "mirror:check": "bun scripts/mirrorCheck/mirrorCheck.ts"
  },
  "dependencies": {
    "@lamarge/sdk": "0.8.0",
    "viem": "^2.57.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
